# Matelematics environment template
# Copy to .env.local for local development.
# NEVER commit .env.local or real credentials.

# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only Supabase configuration
# SUPABASE_URL should normally match NEXT_PUBLIC_SUPABASE_URL, but server code
# must prefer the private server variable when present.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY

# Demo email service - server only
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=YOUR_SMTP_USER
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_FROM=Matelematics <no-reply@example.com>
MAIL_TO=contact@example.com

# Teltonika development server
TELTONIKA_HOST=0.0.0.0
TELTONIKA_PORT=5000
TELTONIKA_CONTROL_PORT=5001

# Optional development device registry
# TELTONIKA_DEV_DEVICES=IMEI:vehicle-id:company-id

# Traccar lab bridge; replace placeholders in .env.local only.
TRACCAR_BASE_URL=http://127.0.0.1:8082
TRACCAR_API_USER=READ_ONLY_TRACCAR_USER
TRACCAR_API_PASSWORD=SET_LOCALLY_DO_NOT_COMMIT
TRACCAR_ALLOWED_IMEIS=000000000000001,000000000000002
TRACCAR_INITIAL_LOOKBACK_MINUTES=10
TRACCAR_POLL_INTERVAL_MS=5000
# For explicit test tenant writes only:
# TRACCAR_BRIDGE_ALLOW_WRITES=I_ACCEPT_TEST_ONLY_WRITES
# TRACCAR_TEST_COMPANY_ID=00000000-0000-4000-8000-000000000000
